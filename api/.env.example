PORT=4000
DATABASE_URL=postgres://pulsecheck:pulsecheck@localhost:5432/pulsecheck
# If set, every /api request must send "Authorization: Bearer <API_TOKEN>"
API_TOKEN=
# Days of check history to keep
RETENTION_DAYS=30
# Consecutive failures before an incident is opened
FAILURES_BEFORE_INCIDENT=2
SCHEDULER_TICK_MS=5000
